# Lightweight dashboard image for App Runner
# No Jolt Atlas binary, ONNX model, or QEMU needed — read-only mode

FROM public.ecr.aws/docker/library/python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 x402user && \
    mkdir -p /app/data && \
    chown -R x402user:x402user /app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY --chown=x402user:x402user . .

USER x402user

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/ping || exit 1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENV=production \
    PORT=8000 \
    DASHBOARD_ONLY=true

CMD ["python", "-u", "dashboard_server.py"]
