# Optimized multi-stage build for production deployment

# Stage 1: Python dependency builder
FROM python:3.11-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy production requirements only
COPY requirements-prod.txt .

# Install dependencies with caching
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-prod.txt

# Stage 2: Runtime (minimal image)
FROM python:3.11-slim

# Install only curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 x402user && \
    mkdir -p /app/data /app/zkengine /app/zkengine_wasm && \
    chown -R x402user:x402user /app

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Copy application code (order matters for caching)
# Copy local zkEngine binary
COPY --chown=x402user:x402user zkengine/ zkengine/

# Copy Python modules
COPY --chown=x402user:x402user *.py ./
COPY --chown=x402user:x402user auth/ auth/
COPY --chown=x402user:x402user tasks/ tasks/
COPY --chown=x402user:x402user static/ static/

# Copy config files
COPY --chown=x402user:x402user config.py .
COPY --chown=x402user:x402user openapi.yaml .

# Create data directory
RUN mkdir -p data logs && \
    chown -R x402user:x402user data logs && \
    chmod +x /app/zkengine/fraud_detector

# Switch to non-root user
USER x402user

# Expose ports (8000 for Render/standard, 8080 for AgentCore)
EXPOSE 8000
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENV=production \
    ZKENGINE_BINARY_PATH=./zkengine/fraud_detector \
    ZKENGINE_CWD=/app/zkengine_wasm

# Default: gunicorn on port 8000 (override PORT=8080 for AgentCore)
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "server:app"]
