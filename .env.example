# ============================================================================
# x402 Insurance API Configuration
# ============================================================================
# SECURITY WARNING: Never commit the actual .env file to git!
# This is a template. Copy to .env and fill in your actual values.
# All wallet and blockchain settings are REQUIRED.
# ============================================================================

# App
APP_NAME="x402 Insurance API"
ENV=production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@host:5432/x402insurance

# Blockchain (Base Mainnet)
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Wallet (REQUIRED — funded with ETH for gas + USDC for refunds)
BACKEND_WALLET_PRIVATE_KEY=<your-funded-mainnet-key>
BACKEND_WALLET_ADDRESS=<corresponding-address>

# Blockchain limits
MAX_GAS_PRICE_GWEI=100
MAX_RETRIES=3

# Jolt Atlas Prover (REQUIRED — real binary, no mock mode)
JOLT_BINARY_PATH=./jolt-atlas/jolt_claims_prover
ONNX_MODEL_PATH=./models/claim_classifier.onnx

# Insurance (percentage-based)
PREMIUM_PERCENTAGE=0.01
MAX_COVERAGE_USDC=0.1
POLICY_DURATION_HOURS=24

# x402 facilitator-based payment verification (always used)
FACILITATOR_URL=https://x402.org/facilitator
PAYMENT_MAX_AGE_SECONDS=300

# Reserve monitoring
MIN_RESERVE_RATIO=1.5

# Rate limiting
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379  # Optional Redis for distributed rate limiting

# Security
REQUIRE_CLAIM_AUTHENTICATION=true
CORS_ORIGINS=  # Set to your domain, e.g., https://yourdomain.com

# Rate Limits (requests per time period)
RATE_LIMIT_DEFAULT=200 per day
RATE_LIMIT_INSURE=50 per hour
RATE_LIMIT_CLAIM=10 per hour
RATE_LIMIT_RENEW=5 per hour

# Timeouts (in seconds)
JOLT_TIMEOUT=60
BLOCKCHAIN_CONFIRMATION_TIMEOUT=120

# Redis (for rate limiting and Huey task queue)
REDIS_URL=redis://localhost:6379/0

# Monitoring & Error Tracking (optional but recommended for production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_RELEASE=x402-insurance@1.0.0
